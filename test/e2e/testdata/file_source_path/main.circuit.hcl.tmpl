circuit "copy" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "app_conf" {
    file {
      path        = "/etc/app/app.conf"
      source_path = "/usr/share/doc/app/app.conf.sample"
      mode        = "0640"
      group       = "adm"
      backup      = true
    }
  }
}
