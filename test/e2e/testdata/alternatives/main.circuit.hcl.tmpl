circuit "tools" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }
{{if .Path}}
  step "tool" {
    alternatives {
      name      = "tool"
      link      = "/usr/local/bin/tool"
      path      = "{{.Path}}"
      priority  = 10
      on_remove = "delete"
    }
  }
{{end}}
}
