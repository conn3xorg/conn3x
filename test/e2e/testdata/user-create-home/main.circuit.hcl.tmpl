circuit "app" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "svc" {
    user {
      name        = "conn3xsvc"
      system      = true
      shell       = "/usr/sbin/nologin"
      comment     = "Conn3x service, test"
      create_home = {{.CreateHome}}
    }
  }
}
