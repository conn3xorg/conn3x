circuit "ipt" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "tools" {
    for_each = [{{.Packages}}]
    package {
      name = item.value
    }
  }

  step "replies" {
    depends_on = [conn3x_package.ipt__tools]

    iptables_rule {
      chain    = "INPUT"
      ctstate  = ["ESTABLISHED", "RELATED"]
      jump     = "ACCEPT"
      position = "insert"
      persist  = true
    }
  }
{{if .Rules}}
  step "ssh" {
    depends_on = [conn3x_iptables_rule.ipt__replies]

    iptables_rule {
      chain            = "INPUT"
      protocol         = "tcp"
      destination_port = "22"
      jump             = "ACCEPT"
      persist          = true
      confirm_after    = "20s"
    }
  }
{{end}}
  step "drop" {
    depends_on = [{{if .Rules}}conn3x_iptables_rule.ipt__ssh{{else}}conn3x_iptables_rule.ipt__replies{{end}}]

    iptables_rule {
      chain   = "INPUT"
      jump    = "DROP"
      persist = true
    }
  }
}
