circuit "app" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "conf" {
    block {
      path    = "/etc/conn3x-block.conf"
      create  = true
      marker  = "{{.Marker}}"
      content = "key = value\n"
    }
  }
}
