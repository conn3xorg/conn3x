circuit "tool" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  # Nothing before it changes the host, so it reads at plan.
  probe "has_hello" {
    command = "test -x /usr/local/bin/hello"
  }

  step "install" {
    only_if = data.conn3x_command.tool__has_hello[each.key].exit_code != 0
    command {
      command = "printf '#!/bin/sh\\necho hello\\n' > /usr/local/bin/hello && chmod 755 /usr/local/bin/hello && echo x >> /var/log/hello.installs"
    }
  }

  step "marker" {
    only_if = data.conn3x_command.tool__has_hello[each.key].exit_code != 0
    file {
      path    = "/etc/hello.installed"
      content = "by Conn3x\n"
    }
  }
}
