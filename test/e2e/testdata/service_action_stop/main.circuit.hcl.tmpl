circuit "app" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "unit" {
    file {
      path    = "/etc/systemd/system/conn3x-busy.service"
      content = "[Service]\nExecStart=/bin/sleep infinity\n"
    }
  }

  step "stop" {
    service_action {
      name     = "conn3x-busy"
      action   = "stop"
      triggers = { n = "{{.N}}" }
    }
  }

  # Not installed: stop leaves it alone, as on a first apply.
  step "stop_missing" {
    service_action {
      name     = "conn3x-not-installed"
      action   = "stop"
      triggers = { n = "{{.N}}" }
    }
  }

  # Its unit file is removed while it runs: not-found, but still active.
  step "stop_orphan" {
    service_action {
      name     = "conn3x-orphan"
      action   = "stop"
      triggers = { n = "{{.N}}" }
    }
  }
}
