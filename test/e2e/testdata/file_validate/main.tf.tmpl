resource "conn3x_file" "sudoers" {
  path     = "/etc/sudoers.d/deploy"
  content  = "{{.Content}}"
  mode     = "0440"
  validate = "visudo -cf %s"

  ssh {
    host             = "127.0.0.1"
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }
}
