circuit "kiosk" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }
{{if .State}}
  step "hello" {
    flatpak {
      name      = "org.test.Hello"
      remote    = "local"
      state     = "{{.State}}"
      on_remove = "delete"
    }
  }
{{end}}
}
