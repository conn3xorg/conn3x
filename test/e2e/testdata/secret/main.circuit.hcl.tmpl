variable "db_password" {
  type      = string
  sensitive = true
  default   = "{{.Secret}}"
}

circuit "db" {
  hosts = { db1 = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "password" {
    file {
      path       = "/root/db-password"
      content_wo = var.db_password
      mode       = "0600"
    }
  }

  step "pgpass" {
    template {
      source      = "${path.module}/pgpass.tftpl"
      destination = "/root/.pgpass"
      vars        = { password = var.db_password }
      mode        = "0600"
      write_only  = true
    }
  }
}
