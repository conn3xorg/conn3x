circuit "pk" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }
{{if .Present}}
  step "data" {
    pack {
      paths     = ["/srv/data", "/srv/logs/*.log"]
      dest      = "/backup/data.tgz"
      exclude   = ["/srv/data/cache"]
      mode      = "0640"
      on_remove = "delete"
    }
  }
{{end}}
}
