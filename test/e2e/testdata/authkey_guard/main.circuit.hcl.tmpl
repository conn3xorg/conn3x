circuit "guard" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "k" {
    authorized_key {
      user = "{{.User}}"
      key  = "{{.PublicKey}}"
    }
  }
}
