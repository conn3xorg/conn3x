circuit "db" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "deploy"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
    become           = {{.Become}}
  }

  step "app_db" {
    import = true
    mysql_database {
      name      = "app"
      charset   = "utf8mb4"
      collation = "utf8mb4_bin"
    }
  }

  step "app_user" {
    import = true
    mysql_user {
      name = "app"
      host = "{{.Host}}"
{{- if .Password}}
      password_wo = "{{.Password}}"
{{- end}}
      grants = {
        app = ["ALL PRIVILEGES"]
      }
    }
  }
}
