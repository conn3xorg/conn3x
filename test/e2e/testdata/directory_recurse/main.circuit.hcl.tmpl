circuit "tree" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "app" {
    directory {
      path    = "/srv/app"
      owner   = "deploy"
      mode    = "u=rwX,g=rX,o="
      recurse = true
    }
  }
}
