circuit "access" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "carol" {
    user {
      name  = "carol"
      shell = "/bin/bash"
    }
  }

  step "carol_key" {
    authorized_key {
      user = "carol"
      key  = "{{.PublicKey}}"
    }
  }
}
