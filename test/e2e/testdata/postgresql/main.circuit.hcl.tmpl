circuit "db" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "app_role" {
    postgresql_role {
      name        = "app"
      attributes  = [{{.Attributes}}]
      password_wo = "{{.Password}}"
    }
  }

  step "app_db" {
    postgresql_database {
      name     = "app"
      owner    = "app"
      encoding = "UTF8"
    }
  }
}
