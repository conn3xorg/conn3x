circuit "box" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "tool" {
    package {
      name = "ufw"
    }
  }

  step "logging" {
    ufw_settings {
      logging = "{{.Logging}}"
    }
  }
}
