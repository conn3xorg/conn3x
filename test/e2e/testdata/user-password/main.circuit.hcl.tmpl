circuit "app" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "user" {
    user {
      name               = "conn3xpw"
      password_wo        = "{{.Password}}"
      password_on_create = {{.OnCreate}}
    }
  }
}
