variable "secret" {
  type      = string
  sensitive = true
  default   = "hunter2"
}

resource "conn3x_file" "secret" {
  path    = "/etc/app-secret"
  content = var.secret
  mode    = "0600"

  ssh {
    host             = "127.0.0.1"
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }
}
