circuit "guard" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "k" {
    known_hosts {
      host = "git.example"
      key  = "{{.PublicKey}}"
      user = "{{.User}}"
    }
  }
}
