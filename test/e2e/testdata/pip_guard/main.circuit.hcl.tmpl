circuit "py" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "p" {
    pip {
      name = "six"
      venv = "{{.Venv}}"
      {{if .User}}user = "{{.User}}"{{end}}
    }
  }
}
