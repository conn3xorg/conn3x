circuit "fw" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "ssh" {
    import = true
    ufw {
      action = "allow"
      port   = "22/tcp"
    }
  }

  step "x11" {
    import = true
    ufw {
      action = "deny"
      port   = "6000:6007/tcp"
      from   = "10.0.0.0/8"
    }
  }
{{if .Missing}}
  step "web" {
    import = true
    ufw {
      action = "allow"
      port   = "8080/tcp"
    }
  }
{{end}}
}
