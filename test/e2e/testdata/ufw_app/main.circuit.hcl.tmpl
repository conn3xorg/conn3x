circuit "fw" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "ufw" {
    package {
      name = "ufw"
    }
  }

  step "ssh" {
    ufw {
      action = "allow"
      app    = "OpenSSH"
    }
  }
{{if .WebApp}}
  step "web" {
    ufw {
      action = "allow"
      app    = "{{.WebApp}}"
      from   = "10.0.0.0/8"
    }
  }
{{end}}
}
