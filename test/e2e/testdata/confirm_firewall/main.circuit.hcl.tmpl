circuit "box" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "tool" {
    package {
      name = "{{.Tool}}"
    }
  }
{{if .Rule}}
  step "ssh" {
{{- if eq .Tool "ufw"}}
    ufw {
      action        = "allow"
      port          = "22/tcp"
      confirm_after = "20s"
    }
{{- else}}
    firewalld {
      service       = "ssh"
      confirm_after = "20s"
    }
{{- end}}
  }
{{end}}
}
