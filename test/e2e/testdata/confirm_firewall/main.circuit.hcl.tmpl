circuit "box" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "tool" {
    package {
      name = "{{.Tool}}"
    }
  }
{{if .Rule}}
  step "ssh" {
{{- if eq .Tool "ufw"}}
    ufw {
      action        = "allow"
{{- if .App}}
      app           = "OpenSSH"
{{- else}}
      port          = "22/tcp"
{{- end}}
      confirm_after = "20s"
    }
{{- else}}
    firewalld {
      service       = "ssh"
      confirm_after = "20s"
    }
{{- end}}
  }
{{end}}
{{- if .Deny}}
  step "deny" {
    depends_on = [{{if .Rule}}conn3x_ufw_rule.box__ssh{{else}}conn3x_package.box__tool{{end}}]

    ufw {
      action = "deny"
      port   = "22"
    }
  }
{{end}}
}
