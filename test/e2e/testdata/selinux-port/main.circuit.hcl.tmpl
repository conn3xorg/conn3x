circuit "web" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  # A container has no SELinux of its own, so the step does nothing.
  step "alt_port" {
    selinux_port {
      port   = 8081
      setype = "http_port_t"
    }
  }
}
