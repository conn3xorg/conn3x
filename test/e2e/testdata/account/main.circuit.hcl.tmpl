circuit "people" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "ops" {
    group {
      name = "ops"
      gid  = 2500
    }
  }
{{if .WithUser}}
  step "alice" {
    user {
      name      = "alice"
      groups    = ["ops"]
      shell     = "/bin/sh"
      on_remove = "delete"
    }
  }
{{end}}}
