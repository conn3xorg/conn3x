circuit "upgrade" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "busy" {
    command {
      command = "touch /run/conn3x-lock; (sleep 3; rm -f /run/conn3x-lock) >/dev/null 2>&1 &"
    }
  }

  step "unlocked" {
    wait_for {
      path    = "/run/conn3x-lock"
      state   = "absent"
      timeout = "30s"
    }
  }

  step "nothing_on_9" {
    wait_for {
      port  = 9
      state = "absent"
    }
  }
}
