circuit "app" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "env" {
    command {
      command = "printf '%s|%s' \"$PREFIX\" \"$GREETING\" > /tmp/conn3x-env"
      unless  = "[ \"$(cat /tmp/conn3x-env 2>/dev/null)\" = \"$PREFIX|$GREETING\" ]"
      environment = {
        PREFIX   = "{{.Prefix}}"
        GREETING = "it's a b"
      }
    }
  }
}
