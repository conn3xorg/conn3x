variable "run" {
  type = string
}

variable "after" {
  type    = bool
  default = false
}

# web's steps need this, so it applies before the rollout.
resource "terraform_data" "before" {
  input = var.run
}

# This needs web's steps, so it can't apply before the rollout.
resource "terraform_data" "after" {
  count      = var.after ? 1 : 0
  input      = var.run
  depends_on = [conn3x_command.web__start]
}

# Declared first, but its steps depend on db's, so db rolls out first.
circuit "web" {
  hosts = {
    web1 = { address = "127.0.0.1", port = {{.PortA}} }
    web2 = { address = "127.0.0.1", port = {{.PortB}} }
  }
  strategy   = "per_host"
  batch_size = 1

  ssh {
    user             = "root"
    private_key_file = "{{.Key}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "start" {
    depends_on = [conn3x_command.db__start]

    command {
      command = "date +%s.%N > /tmp/web # ${terraform_data.before.output}"
    }
  }
}

# Shares web1, so each batch must plan only its own circuit's steps.
circuit "db" {
  hosts = {
    web1 = { address = "127.0.0.1", port = {{.PortA}} }
  }
  strategy   = "per_host"
  batch_size = 1

  ssh {
    user             = "root"
    private_key_file = "{{.Key}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "start" {
    command {
      command = "date +%s.%N > /tmp/db # ${var.run}"
    }
  }
}
