circuit "box" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "tool" {
    package {
      name = "ufw"
    }
  }
{{if .AllowSSH}}
  step "ssh" {
    ufw {
      action = "allow"
      port   = "22/tcp"
    }
  }
{{end}}
  step "firewall" {
    ufw_settings {
      enabled          = true
      default_incoming = "deny"
      default_outgoing = "allow"
    }
  }
}
