- name: Python
  hosts: box
  become: true
  tasks:
    - name: Pinned
      ansible.builtin.pip:
        name: six==1.16.0
        virtualenv: /opt/conv
        virtualenv_command: python3 -m venv
    - name: Also pinned
      pip:
        name: iniconfig
        version: "2.0.0"
        virtualenv: /opt/conv
    - name: From a file
      pip:
        requirements: /opt/requirements.txt
        virtualenv: /opt/conv
