- hosts: box
  vars:
    greeting: from the play
  pre_tasks:
    - name: Make the directory
      file:
        path: /opt/greet
        state: directory
        mode: "0755"
  roles:
    - greet
  tasks:
    - name: After the role
      copy:
        content: "after\n"
        dest: /opt/greet/after.txt
