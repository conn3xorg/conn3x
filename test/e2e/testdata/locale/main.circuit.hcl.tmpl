circuit "lang" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "locales" {
    package {
      name = "{{.Package}}"
    }
  }

  step "lang" {
    locale {
      name = "{{.Locale}}"
    }
  }
}
